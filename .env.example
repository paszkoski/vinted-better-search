# Vinted Better Search — Environment Variables
# Copy this file to .env and fill in your values.
# Pass these to Docker via the environment section in docker-compose.yml.

# ── Optional settings ─────────────────────────────────────────────────────────
# Port exposed on the host (default: 5000)
# PORT=5000

# Vinted country domain (default: https://www.vinted.pl)
# VINTED_BASE_URL=https://www.vinted.de

# Minimum seconds between catalog search requests (default: 1.5)
# MIN_API_DELAY=1.5

# How many item-description pages to fetch in parallel (default: 5)
# DETAIL_CONCURRENCY=5

# Random jitter (seconds) added before each description fetch (default: 0.3)
# DETAIL_JITTER_SECONDS=0.3

# Minimum spacing (seconds) enforced between successive description-fetch
# dispatches, on top of the jitter above (default: 0.5)
# DETAIL_MIN_GAP_SECONDS=0.5

# Seconds to fall back to a plain pause after Vinted returns a 403 block if a
# VPN rotation itself fails (default: 1800 = 30 min). Normally unused — a
# successful rotation lifts the block immediately, see NORDVPN_TOKEN below.
# BLOCK_WAIT_SECONDS=1800

# ── Auto-update (required, repo is private) ────────────────────────────────────
# GitHub PAT with read-only access to this repo (Settings → Developer settings →
# Fine-grained tokens → this repo only → Contents: Read-only). Powers the
# "Update available" button — without it, /api/version and /api/update just
# return an error.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── NordVPN rotation (required — this is how the app avoids getting stuck
#    behind a single blocked IP) ────────────────────────────────────────────────
# NordVPN login token, used by the container's entrypoint to log the bundled
# NordVPN Linux client in (`nordvpn login --token`). Generate one from
# https://my.nordaccount.com → NordVPN → Manual setup → Generate new token.
# Without this, the container starts fine but every Vinted block just falls
# back to the BLOCK_WAIT_SECONDS pause above.
# NORDVPN_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated countries to rotate between on a block (must match names
# from NordVPN's country list, e.g. "Poland,Germany,Netherlands"). Defaults
# to countries near vinted.pl's market; widen or change this if you set
# VINTED_BASE_URL to a different country domain.
# NORDVPN_COUNTRIES=Poland,Germany,Netherlands,Czech Republic

# Minimum seconds between two VPN rotations — avoids hammering NordVPN when
# several concurrent requests hit a block around the same time (default: 15).
# VPN_ROTATE_COOLDOWN_SECONDS=15

# How many times a single blocked request hops to a new VPN server before
# giving up and falling back to the BLOCK_WAIT_SECONDS cooldown (default: 15).
# VPN_MAX_ROTATE_ATTEMPTS=15
