# Vinted Monitor — Environment Variables
# Copy this file to .env and fill in your values.
# Pass these to Docker via the environment section in docker-compose.yml.

# ── Pushover notifications ────────────────────────────────────────────────────
# Get these from https://pushover.net/
PUSHOVER_TOKEN=your_pushover_app_token
PUSHOVER_USER=your_pushover_user_key

# ── n8n Webhook notifications ─────────────────────────────────────────────────
# You can also set this via the web UI (Settings → n8n Webhook)
# N8N_WEBHOOK_URL=https://your-n8n.com/webhook/abc123

# ── Optional settings ─────────────────────────────────────────────────────────
# Port exposed on the host (default: 5000)
# PORT=5000

# Vinted country domain (default: https://www.vinted.pl)
# VINTED_BASE_URL=https://www.vinted.de

# ── Proxy (optional) ──────────────────────────────────────────────────────────
# Proxy in host:port format. When set, the scraper toggles between proxy and
# direct connection on each 403 block. Leave unset to disable proxy entirely.
# VINTED_PROXY=1.2.3.4:8080
